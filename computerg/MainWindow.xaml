<Window x:Class="ComputerGraphicsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerGraphicsDemo"
        mc:Ignorable="d"
        Title="计算机图形学演示教学工具" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="4"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
        </Style>
        
        <Style TargetType="TabControl">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#2C3E50" Padding="12">
            <DockPanel>
                <TextBlock Text="🎨 计算机图形学演示教学工具" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="📝 编译运行" Click="CompileAndRun_Click" Background="#27AE60"/>
                    <Button Content="🔄 刷新渲染" Click="RefreshRender_Click" Background="#3498DB"/>
                    <Button Content="🗑️ 清空画布" Click="ClearCanvas_Click" Background="#E67E22"/>
                    <Button Content="💾 导出代码" Click="ExportCode_Click" Background="#9B59B6"/>
                    <Button Content="📋 加载模板" Click="LoadTemplate_Click" Background="#1ABC9C"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.28*" MinWidth="280"/>
                <ColumnDefinition Width="5" MinWidth="5"/>
                <ColumnDefinition Width="0.42*" MinWidth="400"/>
                <ColumnDefinition Width="5" MinWidth="5"/>
                <ColumnDefinition Width="0.30*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Background="White" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#3498DB" Padding="10">
                        <TextBlock Text="📚 算法选择与属性" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel>
                            <GroupBox Header="选择算法">
                                <StackPanel>
                                    <RadioButton x:Name="rbPreset" Content="预设算法" IsChecked="True" Checked="AlgorithmMode_Checked"/>
                                    <RadioButton x:Name="rbCustom" Content="自定义算法" Checked="AlgorithmMode_Checked"/>
                                    <ComboBox x:Name="AlgorithmComboBox" 
                                              DisplayMemberPath="Name"
                                              SelectionChanged="Algorithm_SelectionChanged"
                                              IsEnabled="{Binding IsChecked, ElementName=rbPreset}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="算法描述">
                                <TextBlock x:Name="AlgorithmDescription" 
                                           TextWrapping="Wrap"
                                           Margin="4"
                                           Height="60"/>
                            </GroupBox>

                            <GroupBox Header="可调属性">
                                <StackPanel x:Name="PropertiesPanel"/>
                            </GroupBox>
                            
                            <GroupBox Header="编译状态" Visibility="Collapsed" x:Name="CompileStatusGroup">
                                <StackPanel>
                                    <TextBlock x:Name="CompileStatusText" 
                                               TextWrapping="Wrap"
                                               Foreground="Gray"
                                               Margin="4"/>
                                    <ScrollViewer MaxHeight="150" Visibility="Collapsed" x:Name="ErrorScrollViewer">
                                        <TextBox x:Name="ErrorTextBox" 
                                                 IsReadOnly="True"
                                                 Background="#FFF5F5"
                                                 Foreground="#D32F2F"
                                                 BorderThickness="0"
                                                 TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#CCCCCC" HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" Background="White" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#27AE60" Padding="10">
                        <DockPanel>
                            <TextBlock x:Name="CodeEditorTitle" Text="💻 算法代码 (只读)" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <Button x:Name="btnEditMode" Content="✏️ 启用编辑" DockPanel.Dock="Right" 
                                    Click="EditMode_Click" Padding="8,4" FontSize="11"
                                    Visibility="Collapsed"/>
                        </DockPanel>
                    </Border>
                    
                    <Grid Grid.Row="1">
                        <TextBox x:Name="CodeTextBox"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#FAFAFA"
                                 BorderThickness="0"
                                 Padding="12"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                        
                        <Border x:Name="CustomEditorOverlay" 
                                Background="Transparent"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Background="#FFF3CD" Padding="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ 编辑模式：您正在编辑自定义算法代码" 
                                                   Foreground="#856404"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="应用更改" Click="ApplyCustomCode_Click" 
                                                Background="#28A745" Padding="8,3" Margin="8,0,0,0"/>
                                        <Button Content="重置" Click="ResetCustomCode_Click" 
                                                Background="#DC3545" Padding="8,3" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                
                                <TextBox Grid.Row="1"
                                         x:Name="CustomCodeTextBox"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="White"
                                         BorderThickness="0"
                                         Padding="12"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#CCCCCC" HorizontalAlignment="Stretch"/>

            <Border Grid.Column="4" BorderBrush="#DDDDDD" BorderThickness="1" Background="White" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#E67E22" Padding="10">
                        <TextBlock Text="🖼️ 实时渲染预览" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    
                    <Border Grid.Row="1" Background="#F8F9FA" Margin="8">
                        <local:RenderCanvas x:Name="RenderCanvas" SizeChanged="RenderCanvas_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>