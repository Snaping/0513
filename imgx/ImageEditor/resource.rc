#include <windows.h>

#define IDD_FILTER_DIALOG 2003
#define IDC_BRIGHTNESS 3001
#define IDC_CONTRAST 3002
#define IDC_SATURATION 3003

IDD_FILTER_DIALOG DIALOGEX 0, 0, 300, 200
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "滤镜调整"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT           "亮度:", -1, 10, 20, 50, 12
    CONTROL         "", IDC_BRIGHTNESS, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 60, 20, 180, 20
    LTEXT           "对比度:", -1, 10, 60, 50, 12
    CONTROL         "", IDC_CONTRAST, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 60, 60, 180, 20
    LTEXT           "饱和度:", -1, 10, 100, 50, 12
    CONTROL         "", IDC_SATURATION, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 60, 100, 180, 20
    DEFPUSHBUTTON   "确定", IDOK, 130, 150, 70, 20
    PUSHBUTTON      "取消", IDCANCEL, 210, 150, 70, 20
END
