{
  "name": "ai-editor-final",
  "version": "1.0.0",
  "description": "AI Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ai.editor",
    "productName": "AI Editor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "files": [
      "**/*",
      "!dist/**"
    ]
  }
}
